+            row_params.vtcm_src1_size = row.src1_bytes;
+            row_params.vtcm_dst_size = row.dst_bytes;
+            row_params.div_ne12_ne1 = init_fastdiv_values(1);
+            row_params.div_ne1 = init_fastdiv_values(1);
+            row_params.div_r2 = init_fastdiv_values(1);
+            row_params.div_r3 = init_fastdiv_values(1);
+            row_params.div_ne11 = init_fastdiv_values(1);
+            use_row_params = true;
+        }
+        for (uint32_t ir = 0; ir < nrows; ++ir) {
+            struct htp_tensor row_src1 = *src1;
+            struct htp_tensor row_dst  = *dst;
+            row_src1.ne[1] = 1;
+            row_dst.ne[1]  = 1;
+            row_src1.data  = src1->data + ir * src1->nb[1];
+            row_dst.data   = dst->data  + ir * dst->nb[1];
+
+            struct htp_ops_context row_octx = *octx;
+            row_octx.src[1] = &row_src1;
+            row_octx.dst    = &row_dst;
+            if (use_row_params) memcpy(row_octx.kernel_params, &row_params, sizeof(row_params));
+            // src[0] weights and src[2] bias stay shared; bias is broadcast.
+
+            const int status = hvx_mm_matmul(&row_octx);
+            if (status != HTP_STATUS_OK) {
+                return status;
+            }
+        }
+        return HTP_STATUS_OK;
+    }
+
     return hvx_mm_matmul(octx);
 }
 
