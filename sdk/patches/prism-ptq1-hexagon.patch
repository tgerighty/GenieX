diff --git a/ggml/src/ggml-hexagon/htp/htp-bf16.h b/ggml/src/ggml-hexagon/htp/htp-bf16.h
new file mode 100644
index 0000000..1a996d6
--- /dev/null
+++ b/ggml/src/ggml-hexagon/htp/htp-bf16.h
@@ -0,0 +1,25 @@
+#ifndef HTP_BF16_H
+#define HTP_BF16_H
+
+#include <stdint.h>
+
+/* Exact BF16->F32: IEEE top 16 bits, lower 16 zero. Not F16. */
+static inline float htp_bf16_bits_to_f32(uint16_t bits) {
+    union {
+        float    f;
+        uint32_t u;
+    } u;
+    u.u = ((uint32_t) bits) << 16;
+    return u.f;
+}
+
+/* Scalar BF16 weight x F32 activation dot. Contiguous K (no stride). */
+static inline float htp_bf16_f32_dot(const uint16_t * w, const float * a, uint32_t k) {
+    float sum = 0.0f;
+    for (uint32_t i = 0; i < k; ++i) {
+        sum += htp_bf16_bits_to_f32(w[i]) * a[i];
+    }
+    return sum;
+}
+
+#endif /* HTP_BF16_H */
