+/* Zero-VTCM BF16 x F32 MUL_MAT over shared DDR. Partitions N (src0 rows). */
+static void hvx_mm_bf16_f32_ddr(unsigned int nth, unsigned int ith, void * data) {
+    struct htp_mm_context * mmctx = (struct htp_mm_context *) data;
+    struct htp_ops_context * octx = mmctx->octx;
+
+    const struct htp_tensor * restrict src0 = octx->src[0];
+    const struct htp_tensor * restrict src1 = octx->src[1];
+    const struct htp_tensor * restrict dst  = octx->dst;
+
+    const uint32_t ne00 = src0->ne[0]; /* K */
+    const uint32_t ne01 = src0->ne[1]; /* N */
+    const uint32_t ne11 = src1->ne[1]; /* M */
+
+    const uint32_t rows_per = (ne01 + nth - 1) / nth;
+    const uint32_t row0     = rows_per * ith;
+    const uint32_t row1     = MIN(row0 + rows_per, ne01);
+    if (row0 >= row1) {
+        return;
+    }
+
+    struct htp_thread_trace * tr = &octx->ctx->trace[ith];
+    htp_trace_event_start(tr, HTP_TRACE_EVT_HVX_COMP, row0);
+
+    const uint8_t * restrict w_base = (const uint8_t *) src0->data;
+    const uint8_t * restrict a_base = (const uint8_t *) src1->data;
+    uint8_t * restrict d_base       = (uint8_t *) dst->data;
+
+    const size_t nb01 = src0->nb[1];
+    const size_t nb11 = src1->nb[1];
+    const size_t nb1  = dst->nb[1];
+
+    for (uint32_t ir1 = 0; ir1 < ne11; ++ir1) {
+        const float * restrict act = (const float *) (a_base + ir1 * nb11);
+        float * restrict dst_col   = (float *) (d_base + ir1 * nb1);
+
+        for (uint32_t ir0 = row0; ir0 < row1; ++ir0) {
+            const uint16_t * restrict w = (const uint16_t *) (w_base + ir0 * nb01);
+            dst_col[ir0] = htp_bf16_f32_dot(w, act, ne00);
+        }
+    }
+
+    htp_trace_event_stop(tr, HTP_TRACE_EVT_HVX_COMP, row0);
+}
