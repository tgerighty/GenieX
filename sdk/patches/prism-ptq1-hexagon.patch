+    const size_t matrix_size = n_col_tiles * n_k_tiles * sizeof(geniex_ptq1_tile);
+    for (int64_t i3 = 0; i3 < t->ne[3]; ++i3) {
+        for (int64_t i2 = 0; i2 < t->ne[2]; ++i2) {
+            uint8_t * dst = (uint8_t *) data + (i3 * t->ne[2] + i2) * ggml_row_size(t->type, t->ne[0]) * t->ne[1];
+            const geniex_ptq1_tile * src = (const geniex_ptq1_tile *) ((const uint8_t *) t->data + (i3 * t->ne[2] + i2) * matrix_size);
+            for (size_t ct = 0; ct < n_col_tiles; ++ct) {
+                const unsigned valid_rows = (unsigned) std::min<int64_t>(GENIEX_PTQ1_TILE_ROWS, t->ne[1] - ct * GENIEX_PTQ1_TILE_ROWS);
+                for (size_t kt = 0; kt < n_k_tiles; ++kt) {
+                    geniex_ptq1_unpack_tile(dst + ct * GENIEX_PTQ1_TILE_ROWS * n_k_tiles * sizeof(geniex_ptq1_block), &src[ct * n_k_tiles + kt], n_k_tiles, kt, valid_rows);
+                }
+            }
+        }
+    }
+}
