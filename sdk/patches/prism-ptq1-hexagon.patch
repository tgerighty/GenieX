+static int hvx_mm_bf16_f32_validate(const struct htp_ops_context * octx) {
+    const struct htp_tensor * src0 = octx->src[0];
+    const struct htp_tensor * src1 = octx->src[1];
+    const struct htp_tensor * src2 = octx->src[2];
+    const struct htp_tensor * dst  = octx->dst;
+
+    if (!src0 || !src1 || !dst) {
+        return HTP_STATUS_INVAL_PARAMS;
+    }
+    if (src2) {
+        return HTP_STATUS_NO_SUPPORT; /* no fused bias */
+    }
+    if (src0->type != HTP_TYPE_BF16 || src1->type != HTP_TYPE_F32 || dst->type != HTP_TYPE_F32) {
+        return HTP_STATUS_NO_SUPPORT;
+    }
+    if (src0->ne[0] != src1->ne[0] || src0->ne[0] == 0 ||
+        src0->ne[1] == 0 || src1->ne[1] == 0 || octx->n_threads == 0) {
+        return HTP_STATUS_INVAL_PARAMS;
+    }
+    if (src0->ne[2] != 1 || src0->ne[3] != 1 || src1->ne[2] != 1 || src1->ne[3] != 1 ||
+        dst->ne[2] != 1 || dst->ne[3] != 1) {
+        return HTP_STATUS_NO_SUPPORT;
+    }
+    if (dst->ne[0] != src0->ne[1] || dst->ne[1] != src1->ne[1]) {
+        return HTP_STATUS_INVAL_PARAMS;
+    }
+    if (src0->nb[0] != sizeof(uint16_t) || src1->nb[0] != sizeof(float) || dst->nb[0] != sizeof(float)) {
+        return HTP_STATUS_INVAL_PARAMS;
+    }
+    if (src0->nb[1] < src0->nb[0] * src0->ne[0] ||
+        src1->nb[1] < src1->nb[0] * src1->ne[0] ||
+        dst->nb[1]  < dst->nb[0]  * dst->ne[0] ||
+        src0->nb[1] % sizeof(uint16_t) || src1->nb[1] % sizeof(float) ||
+        dst->nb[1] % sizeof(float)) {
+        return HTP_STATUS_INVAL_PARAMS;
+    }
+    if (!src0->data || !src1->data || !dst->data) {
+        return HTP_STATUS_INVAL_PARAMS;
+    }
+    return HTP_STATUS_OK;
+}
