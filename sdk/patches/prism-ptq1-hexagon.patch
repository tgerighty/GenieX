+// One weight DMA pass across all activation rows; arithmetic matches M1.
+static void hvx_mm_2d_repacked_ptq1_batch(unsigned int nth, unsigned int ith, void *data) {
+    htp_matmul_preamble;
+    const uint32_t first = src0_nrows_per_thread * ith;
+    const uint32_t last = MIN(first + src0_nrows_per_thread, ne01);
+    const uint32_t ct_end = (last + 31) / 32;
+    const uint32_t blocks = ne00 / GENIEX_PTQ1_BLOCK_K;
+    const uint32_t tile_bytes = blocks * sizeof(geniex_ptq1_tile);
+    uint8_t *weight_buffer = mmctx->vtcm_src0 + ith * mmctx->vtcm_src0_size_per_thread;
+    uint8_t *worker_scratch = mmctx->vtcm_dst + ith * mmctx->vtcm_dst_size_per_thread;
+    float *tmp = (float *) worker_scratch;
+    geniex_ptq1_activation *act = (geniex_ptq1_activation *)
+        (worker_scratch + mmctx->vtcm_dst_size_per_thread - HTP_MM_PTQ1_ACT_SCRATCH_SIZE);
+    uint32_t push_ct = first / 32;
+    if (first < last) {
+        const uint32_t count = MIN(last, ne0) > first ? MIN(last, ne0) - first : 0;
+        if (src2 && count) {
+            dma_queue_push(dma_queue, dma_make_ptr((float *) mmctx->vtcm_src2 + first,
+                (const float *) src2->data + first), count * sizeof(float),
+                count * sizeof(float), count * sizeof(float), 1);
+            dma_queue_pop_nowait(dma_queue);
+        }
+        for (uint32_t d = 0; d < 2 && push_ct < ct_end; ++d, ++push_ct) {
+            dma_queue_push(dma_queue, dma_make_ptr(weight_buffer + d * tile_bytes,
+                (const uint8_t *) src0->data + push_ct * tile_bytes),
+                sizeof(geniex_ptq1_tile), sizeof(geniex_ptq1_tile), sizeof(geniex_ptq1_tile), blocks);
+        }
+    }
+    hvx_mm_run_quant_task(mmctx, ith);
+    if (first >= last) return;
+    enum { scales_per_row = 4 * (5120 / GENIEX_PTQ1_BLOCK_K) };
+    float *prepared_scales = NULL;
+    if (ne10 == 5120 && ne11 >= 2 && ne11 <= 31 && ct_end - first / 32 >= 4 &&
+        mmctx->vtcm_dst_size_per_thread >= HTP_MM_PTQ1_ACT_SCRATCH_SIZE + 64 * sizeof(float) + (size_t) ne11 * scales_per_row * sizeof(float)) {
+        prepared_scales = tmp + 64;
+        for (uint32_t ir = 0; ir < ne11; ++ir) {
+            geniex_ptq1_prepare_flat_scales(prepared_scales + ir * scales_per_row,
+                mmctx->vtcm_src1 + ir * mmctx->vtcm_src1_stride, ne10);
+        }
+    }
+
+    for (uint32_t ct = first / 32; ct < ct_end;) {
+        uint8_t *w0 = dma_queue_pop(dma_queue).dst;
+        uint8_t *w1 = ct + 1 < ct_end ? dma_queue_pop(dma_queue).dst : NULL;
+        const uint32_t col = ct * 32;
+        const uint32_t valid0 = MIN(32, ne0 > col ? ne0 - col : 0);
+        const uint32_t valid1 = w1 ? MIN(32, ne0 > col + 32 ? ne0 - col - 32 : 0) : 0;
+        for (uint32_t ir = 0; ir < ne11; ++ir) {
+            const uint8_t *q8 = mmctx->vtcm_src1 + ir * mmctx->vtcm_src1_stride;
+            if (w1) {
+                geniex_ptq1_dot_pair_flat_q8_scaled(ne10, tmp, tmp + 32,
+                    (const geniex_ptq1_tile *) w0, (const geniex_ptq1_tile *) w1,
+                    q8, valid0, valid1, act,
+                    prepared_scales ? prepared_scales + ir * scales_per_row : NULL);
+            } else {
+                geniex_ptq1_dot_flat_q8(ne10, tmp, (const geniex_ptq1_tile *) w0, q8, valid0, act);
+            }
+            const uint32_t count = valid0 + valid1;
+            if (count) {
+                uint8_t *out = (uint8_t *) dst->data + ir * nb1 + col * sizeof(float);
+                if (src2) {
+                    hvx_add_f32_uaa(out, (const uint8_t *) tmp,
+                        (const uint8_t *) ((const float *) mmctx->vtcm_src2 + col), count);
+                } else {
+                    hvx_copy_f32_ua(out, (const uint8_t *) tmp, count);
+                }
+            }
+        }
+        if (push_ct < ct_end) {
+            dma_queue_push(dma_queue, dma_make_ptr(w0, (const uint8_t *) src0->data + push_ct * tile_bytes),
+                sizeof(geniex_ptq1_tile), sizeof(geniex_ptq1_tile), sizeof(geniex_ptq1_tile), blocks);
+            ++push_ct;
+        }
+        if (w1 && push_ct < ct_end) {
+            dma_queue_push(dma_queue, dma_make_ptr(w1, (const uint8_t *) src0->data + push_ct * tile_bytes),
+                sizeof(geniex_ptq1_tile), sizeof(geniex_ptq1_tile), sizeof(geniex_ptq1_tile), blocks);
+            ++push_ct;
+        }
+        ct += w1 ? 2 : 1;
+    }
